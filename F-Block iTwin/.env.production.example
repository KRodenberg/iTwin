# Production build example. Store real values in GitHub Actions secrets or pass
# them as Docker build args; do not commit `.env.production`.
IMJS_AUTH_CLIENT_CLIENT_ID=""
IMJS_AUTH_CLIENT_REDIRECT_URI="https://itwinapp.geopointstudio.com/signin-callback"
IMJS_AUTH_CLIENT_LOGOUT_URI="https://itwinapp.geopointstudio.com/"
IMJS_AUTH_CLIENT_SCOPES="itwin-platform"
IMJS_AUTH_AUTHORITY="https://ims.bentley.com"

IMJS_ITWIN_ID=""
IMJS_IMODEL_ID=""

SKIP_PREFLIGHT_CHECK=true
USE_FAST_SASS=true
USE_FULL_SOURCEMAP=false
TRANSPILE_DEPS=false
USING_NPM=true
GENERATE_SOURCEMAP=false

IMJS_BING_MAPS_KEY=""
IMJS_MAP_BOX_KEY=""
IMJS_CESIUM_ION_KEY=""
